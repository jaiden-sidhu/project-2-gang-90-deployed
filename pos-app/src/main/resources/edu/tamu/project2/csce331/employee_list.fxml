<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<StackPane styleClass="app-root" stylesheets="@cashier.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.tamu.project2.csce331.EmployeeController">
   <Pane prefHeight="800.0" prefWidth="1280.0">
      <children>
         <Pane layoutY="-1.0" prefHeight="64.0" prefWidth="1280.0" styleClass="top-bar">
            <children>
               <Text fill="WHITE" layoutX="14.0" layoutY="38.0" strokeType="OUTSIDE" strokeWidth="0.0" styleClass="top-title" text="Employees" />
               <Text fx:id="status_label" fill="WHITE" layoutX="1231.0" layoutY="38.0" strokeType="OUTSIDE" strokeWidth="0.0" styleClass="top-time" text="Time" />
            </children>
         </Pane>
         <Pane layoutY="64.0" prefHeight="736.0" prefWidth="280.0" styleClass="sidebar">
            <children>
<Button layoutX="12.0" layoutY="54.0" mnemonicParsing="false" onAction="#go_sales" prefHeight="32.0" styleClass="sidebar-button" text="Recent Transactions" />
      <Button layoutX="12.0" layoutY="94.0" mnemonicParsing="false" onAction="#go_products" prefHeight="32.0" styleClass="sidebar-button" text="Products" />
      <Button layoutX="12.0" layoutY="134.0" mnemonicParsing="false" onAction="#go_employees" prefHeight="32.0" styleClass="sidebar-button" text="Employees" />
      <Button layoutX="12.0" layoutY="174.0" mnemonicParsing="false" onAction="#go_x_report" prefHeight="32.0" styleClass="sidebar-button" text="X Report" />
      <Button layoutX="12.0" layoutY="214.0" mnemonicParsing="false" onAction="#go_usage_chart" prefHeight="32.0" styleClass="sidebar-button" text="Usage Chart" />
      <Button layoutX="12.0" layoutY="254.0" mnemonicParsing="false" onAction="#go_sales_report" prefHeight="32.0" styleClass="sidebar-button" text="Sales Report" />
      <Button layoutX="12.0" layoutY="294.0" mnemonicParsing="false" onAction="#go_z_report" prefHeight="32.0" styleClass="sidebar-button" text="Z Report" />
            </children>
         </Pane>
         <Pane layoutX="240.0" layoutY="64.0" prefHeight="736.0" prefWidth="1040.0">
            <children>
               <TableView fx:id="employee_table" layoutX="-7.0" layoutY="14.0" prefHeight="659.0" prefWidth="1017.0">
                  <columns>
                  <TableColumn fx:id="col_id" prefWidth="80.0" text="ID" />
                  <TableColumn fx:id="col_employee" prefWidth="357.0" text="Employee Name" />
                  <TableColumn fx:id="col_role" prefWidth="211.0" text="Role" />
                  <TableColumn fx:id="col_pay" prefWidth="192.0" text="Pay" />
                  <!-- <TableColumn fx:id="col_delete" prefWidth="175.0" text="Delete" /> -->
                  </columns>
               </TableView>
                  <Button layoutX="439.0" layoutY="687.0" mnemonicParsing="false" onAction="#openPopup" styleClass="primary-button" text="Add Employee" />
            </children>
         </Pane>
      </children>
   </Pane>

    <AnchorPane fx:id="addPopup" style="-fx-background-color: rgba(0,0,0,0.5);" visible="false">
      <children>
         <VBox layoutX="420" layoutY="220" prefHeight="300" prefWidth="460" spacing="12" styleClass="popup-box">
            <children>
               <Label text="Enter Employee Name:" />
               <TextField fx:id="name_field" />
               <Label text="Enter Employee Role:" />
               <TextField fx:id="role_field" />
               <Label text="Enter Employee Pay:" />
               <TextField fx:id="pay_field" />
               <Button onAction="#add_employee_button" styleClass="primary-button" text="Confirm Add" />
               <Button onAction="#closePopup" text="Cancel" />
            </children>
         </VBox>
      </children>
   </AnchorPane>
</StackPane>
