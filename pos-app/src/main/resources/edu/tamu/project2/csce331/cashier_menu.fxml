<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane stylesheets="@cashier.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.tamu.project2.csce331.CashierController">
  <VBox prefHeight="800.0" prefWidth="1280.0">
    <children>
      <AnchorPane maxHeight="-1.0" maxWidth="-1.0" prefHeight="-1.0" prefWidth="-1.0" VBox.vgrow="ALWAYS">
        <children>
          <BorderPane prefHeight="800.0" prefWidth="1280.0">
            <top>
              <HBox prefHeight="46.0" spacing="10.0" styleClass="top-bar" BorderPane.alignment="CENTER">
                <padding><Insets bottom="12" left="20" right="20" top="12" /></padding>
                <children>
                  <Label styleClass="top-title" text="Cashier Interface" />
                  <Region HBox.hgrow="ALWAYS" />
                  <Label fx:id="employeeName" styleClass="top-time" text="Logged Out" />
                </children>
              </HBox>
            </top>

            <left>
              <VBox prefWidth="332.0" styleClass="sidebar" BorderPane.alignment="CENTER">
                <padding><Insets bottom="15" left="15" right="15" top="15" /></padding>
                <children>
                  <Button fx:id="managerViewButton" mnemonicParsing="false" onAction="#go_products" text="Manager View" visible="false">
                              <VBox.margin>
                                 <Insets bottom="5.0" />
                              </VBox.margin></Button>
                  <Button mnemonicParsing="false" onAction="#openLoginPopup" text="Change Cashier"></Button>
                  <Region VBox.vgrow="ALWAYS" />
                </children>
              </VBox>
            </left>

            <center>
              <ScrollPane fitToWidth="true" styleClass="drink-menu" BorderPane.alignment="CENTER">
                <content>
                  <GridPane fx:id="drinkGrid" alignment="TOP_LEFT" hgap="10" vgap="10">
                    <padding>
                      <Insets bottom="20" left="20" right="20" top="20" />
                    </padding>
                  </GridPane>
                </content>
              </ScrollPane>
            </center>

            <right>
              <VBox prefWidth="414.0" spacing="15" styleClass="order-panel" BorderPane.alignment="CENTER">
                <padding><Insets bottom="15" left="15" right="15" top="15" /></padding>
                <children>
                  <Label styleClass="order-title" text="Current Order" />
                  <VBox fx:id="orderItems" spacing="10" styleClass="order-item-box">
                    <children>
                      <Label text="No items yet." />
                    </children>
                  </VBox>

                  <Region VBox.vgrow="ALWAYS" />
                  <VBox spacing="10">
                    <HBox>
                      <children>
                        <Label text="Subtotal:" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="subtotalLabel" text="0.00" />
                      </children>
                    </HBox>
                    <HBox>
                      <children>
                        <Label text="Total:" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="totalLabel" text="0.00" />
                      </children>
                    </HBox>
                    <Button fx:id="chargeButton" maxWidth="Infinity" onAction="#openChargePopup" text="Charge" />
                  </VBox>
                </children>
              </VBox>
            </right>
          </BorderPane>
        </children>
      </AnchorPane>
    </children>
  </VBox>

  <AnchorPane fx:id="modifications_popup" style="-fx-background-color: rgba(0,0,0,0.5);" visible="false">
    <children>
      <VBox layoutX="200" layoutY="100" prefHeight="300" prefWidth="440" style="-fx-background-color: #e0e0e0; -fx-background-radius: 10; -fx-padding: 20;">
        <children>
          <Label style="-fx-font-size: 18; -fx-font-weight: bold;" text="Modifications" />
          <HBox spacing="10">
            <Label text="Ice Level:" />
            <Button onAction="#selectModification" text="Less" />
            <Button onAction="#selectModification" text="Normal" />
            <Button onAction="#selectModification" text="More" />
          </HBox>

          <HBox spacing="10">
            <Label text="Sugar Level:" />
            <Button onAction="#selectModification" text="0%" />
            <Button onAction="#selectModification" text="50%" />
            <Button onAction="#selectModification" text="100%" />
          </HBox>

          <Button onAction="#confirmModifications" style="-fx-background-color: #444; -fx-text-fill: white;" text="Confirm" />
          <Button onAction="#closePopup" style="-fx-background-color: #aaa;" text="Cancel" />
        </children>
      </VBox>
    </children>
  </AnchorPane>

  <AnchorPane fx:id="charge_popup" style="-fx-background-color: rgba(0,0,0,0.5);" visible="false">
    <children>
      <VBox layoutX="300" layoutY="200" prefHeight="200" prefWidth="340" spacing="10" style="-fx-background-color: #e0e0e0; -fx-background-radius: 10; -fx-padding: 20;">
        <children>
          <Label text="Enter Customer Name:" />
          <TextField fx:id="customer_name_field" />
          <Button onAction="#confirmCharge" text="Confirm Charge" />
          <Button onAction="#closecharge_popup" text="Cancel" />
        </children>
      </VBox>
    </children>
  </AnchorPane>

  <AnchorPane fx:id="loginPopup" style="-fx-background-color: rgba(0,0,0,0.5);" visible="false">
    <children>
      <VBox layoutX="300" layoutY="200" prefHeight="200" prefWidth="340" spacing="10" style="-fx-background-color: #e0e0e0; -fx-background-radius: 10; -fx-padding: 20;">
        <children>
          <Label text="Enter Name:" />
          <TextField fx:id="loginNameField" />
          <Label text="Enter ID:" />
          <TextField fx:id="loginIDField" />
          <Label fx:id="errorLogin" />
          <Button onAction="#confirmLogin" text="Login" />
          <Button onAction="#closeLoginPopup" text="Cancel" />
        </children>
      </VBox>
    </children>
  </AnchorPane>
</StackPane>
