<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="edu.tamu.project2.csce331.products_controller">

  <left>
    <VBox spacing="10" prefWidth="160" style="-fx-background-color: #d3d3d3;">
      <padding>
        <Insets bottom="20" left="12" right="12" top="20" />
      </padding>

      <Button layoutX="12.0" layoutY="14.0" mnemonicParsing="false" onAction="#go_cashier" prefHeight="32.0" styleClass="sidebar-button" text="Cashier View" />
      <Button layoutX="12.0" layoutY="54.0" mnemonicParsing="false" onAction="#go_sales" prefHeight="32.0" styleClass="sidebar-button" text="Recent Transactions" />
      <Button layoutX="12.0" layoutY="94.0" mnemonicParsing="false" onAction="#go_products" prefHeight="32.0" styleClass="sidebar-button" text="Products" />
      <Button layoutX="12.0" layoutY="134.0" mnemonicParsing="false" onAction="#go_employees" prefHeight="32.0" styleClass="sidebar-button" text="Employees" />
      <Button layoutX="12.0" layoutY="134.0" mnemonicParsing="false" onAction="#go_x_report" prefHeight="32.0" styleClass="sidebar-button" text="X Report" />
      <Button layoutX="12.0" layoutY="134.0" mnemonicParsing="false" onAction="#go_usage_chart" prefHeight="32.0" styleClass="sidebar-button" text="Usage Chart" />
      <Button layoutX="12.0" layoutY="134.0" mnemonicParsing="false" onAction="#go_sales_report" prefHeight="32.0" styleClass="sidebar-button" text="Sales Report" />
      <Button layoutX="12.0" layoutY="134.0" mnemonicParsing="false" onAction="#go_z_report" prefHeight="32.0" styleClass="sidebar-button" text="Z Report" />
      <ToggleButton text="Seasonal" onAction="#do_seasonal_view" maxWidth="Infinity" />
    </VBox>
  </left>

  <center>
    <VBox spacing="10">
      <padding>
        <Insets bottom="20" left="20" right="20" top="20" />
      </padding>

      <Label style="-fx-font-size: 18px;" text="Products" />

      <TextField fx:id="idField" managed="false" visible="false" />

      <GridPane hgap="8" vgap="8">
        <columnConstraints>
          <ColumnConstraints percentWidth="25" />
          <ColumnConstraints percentWidth="25" />
          <ColumnConstraints percentWidth="25" />
          <ColumnConstraints percentWidth="25" />
        </columnConstraints>

        <Label text="Name" GridPane.columnIndex="0" GridPane.rowIndex="0" />
        <TextField fx:id="name_field" promptText="enter drink" GridPane.columnIndex="0" GridPane.rowIndex="1" />

        <Label text="Price $" GridPane.columnIndex="1" GridPane.rowIndex="0" />
        <TextField fx:id="price_field" promptText="5.50" GridPane.columnIndex="1" GridPane.rowIndex="1" />

        <Label text="Quantity" GridPane.columnIndex="2" GridPane.rowIndex="0" />
        <TextField fx:id="quantity_field" promptText="0" GridPane.columnIndex="2" GridPane.rowIndex="1" />

        <HBox spacing="8" GridPane.columnIndex="3" GridPane.rowIndex="1">
          <Button onAction="#handle_save" text="Add" />
          <Button onAction="#handle_clear" text="Clear" />
        </HBox>

        <rowConstraints>
          <RowConstraints />
          <RowConstraints />
        </rowConstraints>
      </GridPane>

      <TableView fx:id="products_table" prefHeight="400">
        <columns>
          <TableColumn fx:id="name_col" prefWidth="300" text="Name" />
          <TableColumn fx:id="price_col" prefWidth="120" text="Price" />
          <TableColumn fx:id="quantity_col" prefWidth="80" text="Quantity" />
          <TableColumn fx:id="actions_col" prefWidth="180" text="Actions" />
        </columns>
      </TableView>
    </VBox>
  </center>

</BorderPane>
